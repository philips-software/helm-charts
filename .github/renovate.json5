{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Self-hosted settings
  username: 'renovate[bot]',
  gitAuthor: 'Renovate Bot <bot@renovateapp.com>',
  onboarding: false,
  platform: 'github',
  forkProcessing: 'disabled',
  // PR settings
  labels: ['dependencies'],
  extends: [
    'config:best-practices',
    ':disableDependencyDashboard',
  ],
  // config:best-practices defaults prHourlyLimit to 2, which throttles this
  // repo to 2 PRs per run. With dozens of managed deps and major updates
  // ordered last, breaking bumps (e.g. caddy-token v1.x) never reached the
  // front of the queue. Lift the hourly cap; prConcurrentLimit (default 10)
  // still bounds the number of simultaneously open PRs.
  prHourlyLimit: 0,
  enabledManagers: ['custom.regex'],
  packageRules: [
    {
      // The grafana chart version is consumed as an ArgoCD targetRevision against
      // the HTTP Helm repo, which does not accept image digests. Track the OCI
      // registry for new versions but never pin to a digest.
      matchPackageNames: ['ghcr.io/grafana-community/helm-charts/grafana'],
      pinDigests: false,
    },
    {
      // The Caddy sidecar intentionally floats on the "2-alpine" tag rather than
      // a pinned patch version. Keep it on the 2.x stream: pick up any updates
      // Docker Hub publishes under that tag, but never let it jump to 3.x.
      matchPackageNames: ['caddy'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // Bump the chart's own version whenever its appVersion is bumped: a
      // republished chart with unchanged version but different content is
      // rejected by Helm repos, so appVersion and version must move together.
      matchFileNames: ['charts/*/Chart.yaml'],
      bumpVersions: [
        {
          name: 'Bump chart version alongside appVersion',
          filePatterns: ['{{packageFileDir}}/Chart.yaml'],
          matchStrings: ['version:\\s*"?(?<version>[^"\\s]+)"?'],
          bumpType: 'patch',
        },
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      matchStringsStrategy: 'any',
      managerFilePatterns: [
        '/\\.github/workflows/.+\\.(yaml|yml)$/',
        '/\\.github/actions/.+\\.(yaml|yml)$/',
        '/charts/.+/values\\.yaml$/',
        '/charts/.+/Chart\\.yaml$/',
        '/.+/templates/.+\\.(yaml|yml)$/',
        '/.+/config/.+\\.(yaml|yml)$/',
      ],
      matchStrings: [
        // appVersion/version in Chart.yaml
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\n.*?(?:appVersion|version):\\s*["\']?(?<currentValue>[^"\'\\s]+)["\']?',
        // appVersion/version in Chart.yaml with registryUrl (either order)
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s+registryUrl=(?<registryUrl>\\S+?)\\s*\\n.*?(?:appVersion|version):\\s*["\']?(?<currentValue>[^"\'\\s]+)["\']?',
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+registryUrl=(?<registryUrl>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n.*?(?:appVersion|version):\\s*["\']?(?<currentValue>[^"\'\\s]+)["\']?',
        // targetRevision (ArgoCD style)
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n\\s*targetRevision:\\s*"?(?<currentValue>[^"\\s]+)"?',
        // targetRevision with registryUrl
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+registryUrl=(?<registryUrl>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n\\s*targetRevision:\\s*"?(?<currentValue>[^"\\s]+)"?',
        // image: field with tag inline (optionally quoted, e.g. ECR-mirrored paths
        // with ${var} interpolation that get quoted to keep YAML happy)
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n\\s*image:\\s*["\']?\\S+?:(?<currentValue>[^"\'\\s]+)["\']?',
        // <name>Image: field with tag inline (e.g. operatorImage), same as above but
        // for keys that aren't the bare "image:" field name
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n\\s*\\w+[Ii]mage:\\s*["\']?\\S+?:(?<currentValue>[^"\'\\s]+)["\']?',
        // tag: field (separated repository/tag format)
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n\\s*tag:\\s*"?(?<currentValue>[^"\\s]+)"?',
        // version: field with registryUrl (either order)
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s+registryUrl=(?<registryUrl>\\S+?)\\s*\\n\\s*version:\\s*"?(?<currentValue>[^"\\s]+)"?',
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+registryUrl=(?<registryUrl>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n\\s*version:\\s*"?(?<currentValue>[^"\\s]+)"?',
        // version: field without registryUrl
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n\\s*version:\\s*"?(?<currentValue>[^"\\s]+)"?',
        // chart_version: field
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s+registryUrl=(?<registryUrl>\\S+?)\\s*\\n\\s*chart_version:\\s*"?(?<currentValue>[^"\\s]+)"?',
        // GitHub workflow env vars (UPPER_CASE: value)
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+?)\\s+depName=(?<depName>\\S+?)\\s*\\n\\s*[A-Z_]+:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
    },
  ],
}
